# ══════════════════════════════════════════════════════════
#  BHUMI — Environment Variables
#  Copy this file to .env and fill in the values.
#  Never commit .env to git.
# ══════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-long-random-string-min-32-chars

# ── Database (Railway Postgres add-on) ────────────────────
# Railway provides DATABASE_URL automatically when you add a Postgres plugin.
# It looks like: postgresql+asyncpg://user:pass@host:5432/railway
DATABASE_URL=postgresql+asyncpg://bhumi:bhumi@localhost:5432/bhumi
SYNC_DATABASE_URL=postgresql+psycopg://bhumi:bhumi@localhost:5432/bhumi

# ── Redis (Railway Redis add-on) ──────────────────────────
# Railway provides REDIS_URL automatically when you add a Redis plugin.
# It looks like: redis://default:pass@host:6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Cloudflare R2 (replaces MinIO) ────────────────────────
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Account ID: Cloudflare Dashboard → right sidebar
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>
S3_BUCKET_DOCUMENTS=bhumi-documents
S3_BUCKET_MODELS=bhumi-models
S3_REGION=auto

# ── CORS ──────────────────────────────────────────────────
# Add your Cloudflare Pages URL here once deployed
# e.g. https://bhumi.pages.dev,https://bhumi.yourdomain.com
CORS_ORIGINS=http://localhost:3000

# ── Frontend (set in Cloudflare Pages environment variables) ──
# This is the Railway API URL — get it after deploying the API
NEXT_PUBLIC_API_URL=https://bhumi-api.up.railway.app

# ── Security ──────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Roles that require MFA (comma-separated)
MFA_REQUIRED_ROLES=SUPERVISOR,DISTRICT_OFFICER,STATE_ADMIN,SYSTEM_ADMIN

# ── Pipeline thresholds ───────────────────────────────────
AUTO_APPROVE_THRESHOLD=0.92
PRIORITY_REVIEW_THRESHOLD=0.75
QA_SAMPLE_RATE=0.05
REVIEW_LOCK_TTL_SECONDS=900
MAX_UPLOAD_MB=100

# ── OCR / ML ──────────────────────────────────────────────
OCR_ENGINES=paddle,tesseract
TESSERACT_LANGS=eng+hin+mar
ENABLE_HANDWRITING_MODEL=true
ENABLE_LLM_FALLBACK=false

# ── Integrations ──────────────────────────────────────────
# Use the mock DILRMP for demos; replace with real URL for production
DILRMP_BASE_URL=https://mock-dilrmp.up.railway.app
DILRMP_API_KEY=demo-key
ENABLE_OUTBOUND_SYNC=true

# ── Notifications ─────────────────────────────────────────
# For demo: use console (logs to stdout). For prod: set NIC SMS credentials.
SMS_PROVIDER=console
SMS_API_KEY=
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_FROM=no-reply@bhumi.gov.in

# ── Postgres (direct values if not using full DATABASE_URL) ──
POSTGRES_DB=bhumi
POSTGRES_USER=bhumi
POSTGRES_PASSWORD=bhumi
