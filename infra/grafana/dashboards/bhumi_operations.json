{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }
  ],
  "title": "BHUMI — Operations",
  "uid": "bhumi-ops",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "tags": ["bhumi", "operations", "api"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API Request Rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 12 } } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum by (route) (rate(http_requests_total{app=\"bhumi-api\"}[2m]))",
        "legendFormat": "{{route}}"
      }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API Error Rate by Status",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "reqps",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "red",   "value": 0.01 }
        ]}
      }},
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum by (status_code) (rate(http_requests_total{app=\"bhumi-api\", status_code=~\"4..|5..\"}[2m]))",
        "legendFormat": "HTTP {{status_code}}"
      }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API Response Time (p95)",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{app=\"bhumi-api\"}[5m])))",
        "legendFormat": "p95 {{route}}"
      }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Celery Task Queue Depth",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "celery_queue_length{app=\"bhumi\"}",
        "legendFormat": "Queue: {{queue_name}}"
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "PostgreSQL Active Connections",
      "gridPos": { "x": 0, "y": 14, "w": 8, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "pg_stat_activity_count{datname=\"bhumi\"}",
        "legendFormat": "Active connections"
      }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Redis Memory Usage",
      "gridPos": { "x": 8, "y": 14, "w": 8, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "redis_memory_used_bytes",
        "legendFormat": "Used"
      }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "MinIO Request Rate",
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(minio_s3_requests_total{server=\"bhumi-minio\"}[5m])",
          "legendFormat": "S3 req/s" }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top Slow API Endpoints (last 1h)",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 7 },
      "options": { "sortBy": [{ "displayName": "p95 latency", "desc": true }] },
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byName", "options": "p95 latency" }, "properties": [{ "id": "unit", "value": "s" }] },
          { "matcher": { "id": "byName", "options": "req/s" },       "properties": [{ "id": "unit", "value": "reqps" }] }
        ]
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{app=\"bhumi-api\"}[1h]))))",
        "legendFormat": "{{route}}",
        "instant": true
      }]
    }
  ]
}
