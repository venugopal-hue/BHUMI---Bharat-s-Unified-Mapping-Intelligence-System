{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }
  ],
  "title": "BHUMI — Pipeline Overview",
  "uid": "bhumi-pipeline",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["bhumi", "pipeline"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Records Processed Today",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1000 },
            { "color": "blue", "value": 5000 }
          ]},
          "unit": "short"
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(increase(bhumi_records_processed_total[24h]))",
        "legendFormat": "Records"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "OCR Accuracy (7-day avg)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["mean"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",    "value": null },
            { "color": "yellow", "value": 0.85 },
            { "color": "green",  "value": 0.95 }
          ]},
          "unit": "percentunit",
          "min": 0, "max": 1
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "avg_over_time(bhumi_record_confidence_mean[7d])",
        "legendFormat": "Accuracy"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Review Queue Depth",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 200 },
            { "color": "red",    "value": 500 }
          ]},
          "unit": "short"
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "bhumi_review_queue_depth{status=\"OPEN\"}",
        "legendFormat": "Open items"
      }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "SLA Breach Rate",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 0.02 },
            { "color": "red",    "value": 0.05 }
          ]},
          "unit": "percentunit"
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "rate(bhumi_sla_breaches_total[1h]) / rate(bhumi_review_completed_total[1h])",
        "legendFormat": "SLA breach rate"
      }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Straight-Through Rate",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",    "value": null },
            { "color": "yellow", "value": 0.4 },
            { "color": "green",  "value": 0.6 }
          ]},
          "unit": "percentunit"
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "bhumi_straight_through_rate",
        "legendFormat": "STR"
      }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active Celery Workers",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": null },
            { "color": "green", "value": 1 }
          ]},
          "unit": "short"
        }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(celery_workers_active{app=\"bhumi\"})",
        "legendFormat": "Workers"
      }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Records Processed / Hour",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 15 } }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (status) (rate(bhumi_records_processed_total[1h]) * 3600)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "OCR Pipeline Latency (p50 / p95 / p99)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 8 } }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, rate(bhumi_ocr_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, rate(bhumi_ocr_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, rate(bhumi_ocr_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Confidence Band Distribution",
      "description": "HIGH ≥0.95 / GOOD ≥0.85 / MEDIUM ≥0.70 / LOW",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 6 },
      "options": { "orientation": "horizontal", "displayMode": "gradient" },
      "fieldConfig": {
        "defaults": { "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",    "value": null },
            { "color": "yellow", "value": 0 },
            { "color": "blue",   "value": 0 },
            { "color": "green",  "value": 0 }
          ]}
        }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "bhumi_records_by_confidence_band{band=\"HIGH\"}",  "legendFormat": "HIGH (≥0.95)" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "bhumi_records_by_confidence_band{band=\"GOOD\"}",  "legendFormat": "GOOD (≥0.85)" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "bhumi_records_by_confidence_band{band=\"MEDIUM\"}","legendFormat": "MEDIUM (≥0.70)" },
        { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "bhumi_records_by_confidence_band{band=\"LOW\"}",   "legendFormat": "LOW (<0.70)" }
      ]
    },
    {
      "id": 13,
      "type": "piechart",
      "title": "Records by Language",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 6 },
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum by (language) (bhumi_records_total)",
        "legendFormat": "{{language}}"
      }]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Integration Sync Success Rate",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 6 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      },
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "rate(bhumi_sync_success_total[5m]) / (rate(bhumi_sync_success_total[5m]) + rate(bhumi_sync_failure_total[5m]))",
        "legendFormat": "{{integration}}"
      }]
    }
  ]
}
